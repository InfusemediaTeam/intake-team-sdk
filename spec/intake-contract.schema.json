{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intake contract 2.0",
  "description": "Every shape exchanged between an intake host and a department MCP server. The single source of truth for both SDKs: tools/list publishes these definitions as each tool's inputSchema and outputSchema. Objects allow unknown properties so a minor version can add one without breaking older readers.",
  "definitions": {
    "TeamIdentity": {
      "type": "object",
      "required": ["key", "title", "subtitle"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$",
          "maxLength": 32
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "subtitle": { "type": "string", "maxLength": 500 }
      }
    },
    "TeamField": {
      "type": "object",
      "required": ["key", "label", "description", "kind", "required"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "maxLength": 64
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "kind": { "type": "string", "enum": ["text", "longText", "enum"] },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 25
        }
      }
    },
    "TeamDescriptor": {
      "type": "object",
      "required": ["contractVersion", "team", "fields", "readinessNotes"],
      "properties": {
        "contractVersion": { "type": "string", "pattern": "^2\\.\\d+$" },
        "team": { "$ref": "#/definitions/TeamIdentity" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/TeamField" },
          "maxItems": 25
        },
        "readinessNotes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 10
        }
      }
    },
    "NullableText": {
      "type": ["string", "null"]
    },
    "IntakeCoreFields": {
      "type": "object",
      "required": ["title", "whatNeeded", "urgency", "businessValue", "approver"],
      "properties": {
        "title": { "$ref": "#/definitions/NullableText" },
        "whatNeeded": { "$ref": "#/definitions/NullableText" },
        "urgency": { "$ref": "#/definitions/NullableText" },
        "businessValue": { "$ref": "#/definitions/NullableText" },
        "approver": { "$ref": "#/definitions/NullableText" }
      }
    },
    "IntakeRequester": {
      "type": "object",
      "description": "Who asked, as shown on a draft. Display data only: the identity a department may act on is TaskRequester, sent with creation.",
      "required": ["displayName", "department"],
      "properties": {
        "displayName": { "$ref": "#/definitions/NullableText" },
        "department": { "$ref": "#/definitions/NullableText" }
      }
    },
    "IntakeDraft": {
      "type": "object",
      "required": ["core", "fieldValues", "requester"],
      "properties": {
        "core": { "$ref": "#/definitions/IntakeCoreFields" },
        "fieldValues": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 5000 }
        },
        "requester": { "$ref": "#/definitions/IntakeRequester" }
      }
    },
    "EmptyInput": {
      "type": "object",
      "properties": {}
    },
    "DraftInput": {
      "type": "object",
      "required": ["draft"],
      "properties": {
        "draft": { "$ref": "#/definitions/IntakeDraft" }
      }
    },
    "ReadinessIssue": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "field": { "type": "string" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "ReadinessVerdict": {
      "type": "object",
      "required": ["ready", "blockers", "warnings"],
      "properties": {
        "ready": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/definitions/ReadinessIssue" },
          "maxItems": 25
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/definitions/ReadinessIssue" },
          "maxItems": 25
        }
      }
    },
    "RenderedTicket": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "TaskRequester": {
      "type": "object",
      "description": "The authenticated requester, resolved by the host from its own records. Over HTTP, userId must equal the service token's sub claim.",
      "required": ["userId", "email"],
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "$ref": "#/definitions/NullableText" }
      }
    },
    "CreateTaskInput": {
      "type": "object",
      "required": ["idempotencyKey", "draft", "requester"],
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "description": "Stable for every attempt at one request. A department must return the same task for a key it has already created.",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "draft": { "$ref": "#/definitions/IntakeDraft" },
        "requester": { "$ref": "#/definitions/TaskRequester" }
      }
    },
    "TaskReference": {
      "type": "object",
      "required": ["id", "displayKey", "url", "location"],
      "properties": {
        "id": {
          "type": "string",
          "description": "The department's own id for the task. The host passes it back to intake_get_task_status.",
          "minLength": 1,
          "maxLength": 256
        },
        "displayKey": {
          "type": "string",
          "description": "What the requester sees, e.g. PROJ-123.",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": ["string", "null"],
          "description": "An http(s) link to the task, or null when it has none.",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "location": {
          "type": ["string", "null"],
          "description": "Where the task was filed, in the department's words: a board, queue or label.",
          "maxLength": 500
        }
      }
    },
    "CreateTaskResult": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "task": { "$ref": "#/definitions/TaskReference" }
      }
    },
    "TaskStatusInput": {
      "type": "object",
      "required": ["taskIds"],
      "properties": {
        "taskIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "minItems": 1,
          "maxItems": 50
        }
      }
    },
    "TaskStatus": {
      "type": "object",
      "required": ["taskId", "category", "label", "assignee", "lastChangedAt"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "category": {
          "type": "string",
          "enum": ["todo", "in_progress", "done"]
        },
        "label": {
          "type": "string",
          "description": "The department's own wording for the state.",
          "minLength": 1,
          "maxLength": 100
        },
        "assignee": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "lastChangedAt": {
          "type": ["string", "null"],
          "description": "ISO-8601, when the department last changed the task.",
          "maxLength": 64
        }
      }
    },
    "TaskStatusResult": {
      "type": "object",
      "description": "One entry per task the department knows. An id it does not know is left out.",
      "required": ["statuses"],
      "properties": {
        "statuses": {
          "type": "array",
          "items": { "$ref": "#/definitions/TaskStatus" },
          "maxItems": 50
        }
      }
    },
    "ToolErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "NOT_READY",
        "REQUESTER_UNRESOLVED",
        "DESTINATION_REJECTED",
        "DESTINATION_UNAVAILABLE",
        "INTERNAL"
      ]
    },
    "ToolError": {
      "type": "object",
      "description": "Sent as the JSON text of an isError result, never as structuredContent: an MCP client validates structuredContent against the success outputSchema.",
      "required": ["error"],
      "properties": {
        "error": { "$ref": "#/definitions/ToolErrorBody" }
      }
    },
    "ToolErrorBody": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/definitions/ToolErrorCode" },
        "message": {
          "type": "string",
          "description": "Safe to show the requester: no credentials, stack traces or upstream payloads.",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether the same call may succeed later unchanged."
        }
      }
    },
    "ServiceTokenClaims": {
      "type": "object",
      "description": "Payload of the HS256 JWT a host sends as Authorization: Bearer on every HTTP request.",
      "required": ["iss", "aud", "scope", "iat", "exp", "jti"],
      "properties": {
        "iss": { "type": "string", "minLength": 1 },
        "aud": { "type": "string", "minLength": 1 },
        "sub": {
          "type": "string",
          "description": "The requester's userId. Required for intake:create and intake_get_task_status.",
          "minLength": 1,
          "maxLength": 128
        },
        "task_ids_sha256": {
          "type": "string",
          "description": "The task ids the host found owned by sub, as the base64url SHA-256 of the exact taskIds array it sends, serialised as compact JSON. Required for intake_get_task_status.",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "scope": {
          "type": "string",
          "description": "Space-separated: intake:read, intake:create."
        },
        "iat": { "type": "integer" },
        "exp": { "type": "integer" },
        "jti": { "type": "string", "minLength": 1 }
      }
    }
  }
}
