{
  "name": "intake-team-sdk",
  "version": "2.0.0",
  "description": "Toolkit for building intake MCP servers in JavaScript/TypeScript: the JSON Schema wire contract, server creation, transports, service-token authentication and generic draft, readiness and rendering helpers. Its source is in packages/js/; a Python SDK with the same contract lives in packages/python/.",
  "license": "MIT",
  "homepage": "https://github.com/InfusemediaTeam/intake-team-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfusemediaTeam/intake-team-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/InfusemediaTeam/intake-team-sdk/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "packages/js/dist/index.js",
  "types": "packages/js/dist/index.d.ts",
  "files": [
    "packages/js/dist",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p packages/js/tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p packages/js/tsconfig.json --noEmit",
    "lint": "eslint \"packages/js/{src,tests}/**/*.ts\"",
    "test": "tsc -p packages/js/tsconfig.json && node --test \"packages/js/dist-test/tests/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm run lint && npm test",
    "generate": "node scripts/generate-contract.mjs",
    "check:generated": "node scripts/generate-contract.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
