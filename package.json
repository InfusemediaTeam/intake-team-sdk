{
  "name": "intake-team-sdk",
  "version": "1.0.0",
  "description": "Toolkit for building intake MCP servers: the wire contract, server creation, transports and generic draft, readiness, rendering and Jira-mapping helpers.",
  "license": "MIT",
  "homepage": "https://github.com/InfusemediaTeam/intake-team-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfusemediaTeam/intake-team-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/InfusemediaTeam/intake-team-sdk/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
